# Copie para .env e troque as senhas: cp .env.example .env
# O .env nunca vai para o GitHub.

# Porta em que o site fica acessível na VM
FRONTEND_PORT=4200

# Senhas do MySQL
DB_SENHA=troque-esta-senha
MYSQL_ROOT_SENHA=troque-esta-tambem

# Login do painel do revendedor, criado na primeira vez que o banco sobe
ADMIN_EMAIL=admin@primecoding.com.br
ADMIN_SENHA=troque-a-senha-do-painel