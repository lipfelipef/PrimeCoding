# Copie para .env e troque as senhas: cp .env.example .env
# O .env nunca vai para o GitHub.

# Porta em que o site fica acessível na VM, sem HTTPS
FRONTEND_PORT=4200

# Nome do site com HTTPS. Sem domínio próprio, o sslip.io dá um nome a partir
# do IP (troque os pontos por hífens). Com domínio, ponha ele aqui.
SITE_DOMINIO=IP-COM-HIFENS.sslip.io

# Senhas do MySQL
DB_SENHA=troque-esta-senha
MYSQL_ROOT_SENHA=troque-esta-tambem

# WhatsApp da loja, só dígitos com o 55 do Brasil
LOJA_WHATSAPP=5511900000000

# Login do painel do revendedor, criado na primeira vez que o banco sobe
# (projeto acadêmico: o login de demonstração é público, de propósito)
ADMIN_EMAIL=admin@admin.com
ADMIN_SENHA=admin